# Modalità prototipo: nessuna chiamata verso l'esterno.
# Usata da `npm run dev:mock` (vite --mode mock).
#
# Questo file è committato apposta: "clone → npm install → npm run dev:mock"
# deve funzionare senza passaggi manuali.

# Il mock server è montato dal plugin Vite su questo prefisso.
# La porta 4300 è imposta dal plugin (strictPort): tenere i due valori allineati,
# il plugin avvisa in console se divergono.
# Deve restare un URL ASSOLUTO: src/lib/api/client.ts fa `new URL(base + path)`,
# che con un path relativo lancia.
VITE_API_BASE_URL=http://localhost:4300/mock-api

# Non esiste nessun SSO in mock mode. Questi due valori servono solo a comporre
# la chiave di localStorage `oidc.user:{authority}:{client_id}` in cui il plugin
# scrive la sessione finta.
VITE_SSO_AUTHORITY=http://mock-sso.local
VITE_COGNITO_CLIENT_ID=mock-client
