# Modalità prototipo per il deploy su Vercel: nessuna chiamata verso l'esterno.
# Usata da `npm run build:demo` (vite build --mode demo).
#
# Questo file è committato apposta, stesso motivo di .env.mock: il deploy
# deve funzionare senza passaggi manuali (niente env var da impostare a mano
# nel dashboard Vercel).

# Relativo, non assoluto come in .env.mock: sulla build statica non conosciamo
# in anticipo il dominio del deploy (produzione vs preview). Risolto contro
# window.location.origin da src/lib/api/client.ts. L'API sotto questo path è
# servita da api/mock-api/[...path].ts (funzione serverless Vercel, riusa lo
# stesso router/handler di mock/).
VITE_API_BASE_URL=/api/mock-api

# Non esiste nessun SSO in demo mode. Questi due valori servono solo a comporre
# la chiave di localStorage `oidc.user:{authority}:{client_id}` in cui il
# plugin (mock/index.ts, transformIndexHtml) scrive la sessione finta.
VITE_SSO_AUTHORITY=http://mock-sso.local
VITE_COGNITO_CLIENT_ID=mock-client
